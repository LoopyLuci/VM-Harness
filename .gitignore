# Log files
logs/
*.log

# Secrets
.env
.env.*
!.env.example
.secrets.json

# SSH known hosts
known_hosts

# ISO files (large binaries)
iso/*.iso
iso/*.img

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
!web/dist/
.eggs/
*.so

# PyInstaller
*.spec

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# GUI credential store (encrypted secrets — never commit)
.local/share/qmcmcp/
.config/qmcmcp/
qmcmcp/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
test-results/
gui.log

# Credential store data files
credentials.json
.master_key
master_key
keyfile

# Secrets and tokens
# Patterns, not just the names that happened to be created once: pairing tokens
# and self-signed certs are generated at runtime, so any of them must be ignored.
token.txt
*token*.txt
*.token
pairing_qr.png

# TLS certificates and keys
cert.pem
key.pem
*.pem
*.p12
*.pfx

# Machine IDs and signing keys
.qmcmcp_machine_id
.vmharness_machine_id
.vmharness_signing_key

# Runtime files
*.pid
.vm_gui.pid
gui/.vmharness_single_instance.lock
file

# Virtual environment
.venv/

# Built binaries
VM-Harness-Installer.exe

# Android build artifacts
android/build/
android/.gradle/
android/local.properties

# Audit database
.audit/audit.db

# CI build artifacts (binaries)
ci/artifacts/desktop/*.exe
ci/artifacts/desktop/*.zip
ci/artifacts/desktop/*.sha256

# Build output and runtime state (never commit)
target/
.vmharness_state/
.vmharness_backup/

# Node dependencies (restore with `npm ci` in web/)
web/node_modules/

# Local CI/CD pipeline (ci/pipeline.py): its logs, reports and lock
ci/logs/
ci/reports/
ci/.pipeline.lock

# Local GUI settings, written by panels_settings and panels_vm_console on import.
# Machine-specific (bridge URL, token path, fps/quality), so it must not be shared.
gui/settings.json
