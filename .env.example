# MCP server configuration
# Copy this file to .env and fill in your values.
# All fields have defaults — only set what you need to override.

# ── SSH (for guest interaction tools) ─────────────────────────────────────────
# The VM must be running and have SSH enabled.  Set either a password or
# a private key path.  If both are set, key takes precedence.

# Password auth (convenient, less secure)
SSH_PASSWORD=

# OR key-based auth (more secure)
SSH_PRIVATE_KEY=

# SSH login details (usually unchanged from defaults)
SSH_HOST=127.0.0.1
SSH_PORT=2222
SSH_USERNAME=OmarchyVM

# ── QMP (QEMU control socket) ──────────────────────────────────────────────────
# The QMP socket is created when the VM starts.  For TCP mode (default), the
# server connects to the address below.  For Unix socket mode, set
# QMP_SOCKET_PATH instead.

QMP_HOST=127.0.0.1
QMP_PORT=4444
# QMP_SOCKET_PATH=

# If QEMU was started with -S (wait for QMP connection), set this password
# QMP_PASSWORD=

# ── Server security ─────────────────────────────────────────────────────────────
# Set AUTH_ENABLED=true to require authentication for all MCP connections.
# When using SSE transport, agents must send: Authorization: Bearer <key>

AUTH_ENABLED=false
AUTH_API_KEY=change-this-to-a-random-secret-in-production

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# LOG_FILE=logs/vm-mcp.log   # uncomment to also log to a file

# ── VM defaults (override if your VM uses different paths) ──────────────────────
# QEMU_BINARY=C:\\Program Files\\qemu\\qemu-system-x86_64.exe
# VM_DISK_PATH=C:\\Users\\Server\\Virtual Machines\\omarchy-vm\\disk.qcow2
# VM_ISO_PATH=C:\\Projects\\Omarchy\\vm-setup\\omarchy-4.0.4.iso
# VM_RAM_MB=8192
# VM_CPUS=4
# VM_DISPLAY=sdl
# VM_GL=true
# VM_NAME=omarchy-vm

# ── Display ─────────────────────────────────────────────────────────────────────
# VM_DISPLAY=sdl       # sdl, gtk, spice, none, cocoa (macOS), dx (Windows)
# VM_GL=true           # enable OpenGL (SDL/gtk only)
